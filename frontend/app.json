{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.twiniqcoach.p7zd3z",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Sync your Twin IQ missions to your calendar",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add Twin IQ missions to your calendar",
        "NSRemindersUsageDescription": "Save mission reminders to your device"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.twiniqcoach.p7zd3z",
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Twin IQ needs access to sync your missions to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}